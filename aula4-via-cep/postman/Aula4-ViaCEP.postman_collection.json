{
  "info": {
    "name": "Java Spring Fundamentals - Aula 4 - ViaCEP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productId",
      "value": "p1"
    },
    {
      "key": "cepMogi",
      "value": "08773380"
    }
  ],
  "item": [
    {
      "name": "Listar produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product"
          ]
        }
      }
    },
    {
      "name": "Buscar produto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "Criar produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-aula4-001"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/product",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mouse Sem Fio\",\n  \"category\": \"Eletrônicos\",\n  \"price\": 180.0,\n  \"distributionCenter\": \"MOGI_DAS_CRUZES\"\n}"
        }
      }
    },
    {
      "name": "Atualizar produto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-aula4-002"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/product/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product",
            "{{productId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Notebook Lenovo Atualizado\",\n  \"category\": \"Eletrônicos\",\n  \"price\": 3600.0,\n  \"distributionCenter\": \"MOGI_DAS_CRUZES\"\n}"
        }
      }
    },
    {
      "name": "Filtrar por categoria",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product?category=Eletrônicos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product"
          ],
          "query": [
            {
              "key": "category",
              "value": "Eletrônicos"
            }
          ]
        }
      }
    },
    {
      "name": "Filtrar por centro",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product/distribution-center/MOGI_DAS_CRUZES",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product",
            "distribution-center",
            "MOGI_DAS_CRUZES"
          ]
        }
      }
    },
    {
      "name": "Top 5 por preço",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product/top-expensive",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product",
            "top-expensive"
          ]
        }
      }
    },
    {
      "name": "Disponibilidade via ViaCEP - mesmo centro",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product/{{productId}}/availability?cep={{cepMogi}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product",
            "{{productId}}",
            "availability"
          ],
          "query": [
            {
              "key": "cep",
              "value": "{{cepMogi}}"
            }
          ]
        }
      }
    },
    {
      "name": "Disponibilidade via ViaCEP - CEP inválido",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product/{{productId}}/availability?cep=123",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product",
            "{{productId}}",
            "availability"
          ],
          "query": [
            {
              "key": "cep",
              "value": "123"
            }
          ]
        }
      }
    },
    {
      "name": "Inativar produto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product",
            "{{productId}}"
          ]
        }
      }
    }
  ]
}